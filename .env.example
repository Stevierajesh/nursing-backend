# Supabase project: appyridejrwfqhocqqyx
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://appyridejrwfqhocqqyx.supabase.co

# service_role key. Bypasses RLS. Server-side only -- never in a frontend .env
SUPABASE_SERVICE_KEY=

# anon key, used by the seed script to simulate client logins
SUPABASE_ANON_KEY=

# Only needed if the project signs tokens with the legacy HS256 shared secret.
# Projects using asymmetric keys verify via JWKS and can leave this blank.
SUPABASE_JWT_SECRET=

JWT_AUDIENCE=authenticated
PROFILE_CACHE_SECONDS=60
JWKS_CACHE_SECONDS=3600

FLASK_ENV=development
PORT=5001

# nurse app on 5173, dashboard on 5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

ENABLE_SCHEDULER=true
RISK_RECOMPUTE_SECONDS=60
SLA_SWEEP_SECONDS=30
